@model FamilyDoctorMVC.Models.Appointment

@{
    ViewData["Title"] = "Edit Appointment";
}

<h2 class="mb-4">Sửa lịch khám</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="AppointmentId" />

    <div class="mb-3">
        <label class="form-label">Bệnh nhân</label>
        <input asp-for="PatientId" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Bác sĩ</label>
        <input asp-for="DoctorUsr" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Ngày khám</label>
        <input asp-for="AppointmentDate" type="datetime-local" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Trạng thái</label>
        <select asp-for="Status" class="form-control">
            <option>Pending</option>
            <option>Completed</option>
            <option>Cancelled</option>
        </select>
    </div>

    <button type="submit" class="btn btn-warning">
        Cập nhật
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>

</form>