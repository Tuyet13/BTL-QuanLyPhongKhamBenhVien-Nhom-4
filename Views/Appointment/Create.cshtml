@model FamilyDoctorMVC.Models.Appointment

@{
    ViewData["Title"] = "Create Appointment";
}

<h2 class="mb-4">Đặt lịch khám</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Bệnh nhân</label>

        <select asp-for="PatientId"
                asp-items="ViewBag.Patients"
                class="form-control">

            <option value="">-- Chọn bệnh nhân --</option>

        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Bác sĩ</label>

        <select asp-for="DoctorUsr"
                asp-items="ViewBag.Doctors"
                class="form-control">

            <option value="">-- Chọn bác sĩ --</option>

        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Ngày giờ khám</label>

        <input asp-for="AppointmentDate"
               type="datetime-local"
               class="form-control" />

    </div>

    <input type="hidden" asp-for="Status" value="Pending" />

    <button type="submit" class="btn btn-primary">
        Đặt lịch
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>

</form>