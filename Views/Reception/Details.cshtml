@model System.Data.DataRow

<h2>Appointment Details</h2>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <td>@Model["AppointmentId"]</td>
    </tr>

    <tr>
        <th>Patient</th>
        <td>@Model["PatientName"]</td>
    </tr>

    <tr>
        <th>Doctor</th>
        <td>@Model["DoctorName"]</td>
    </tr>

    <tr>
        <th>Date</th>
        <td>@Convert.ToDateTime(Model["AppointmentDate"]).ToString("dd/MM/yyyy HH:mm")</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model["Status"]</td>
    </tr>
</table>

<a asp-action="Index" class="btn btn-secondary">Back</a>