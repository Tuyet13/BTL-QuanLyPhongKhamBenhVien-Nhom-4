@using System.Data
@model DataTable

@{
    var row = Model.Rows[0];
}

<h2>Xóa bác sĩ</h2>

<p>Bạn có chắc muốn xóa bác sĩ:</p>

<h4>@row["DoctorName"]</h4>

<form method="post">

    <input type="hidden" name="DoctorUsr" value="@row["DoctorUsr"]" />

    <button class="btn btn-danger">Delete</button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>