@using System.Data
@model DataTable

@{
    var row = Model.Rows[0];
}

<h2>Chi tiết bác sĩ</h2>

<table class="table table-bordered">

    <tr>
        <th>Username</th>
        <td>@row["DoctorUsr"]</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@row["DoctorName"]</td>
    </tr>

    <tr>
        <th>Phone</th>
        <td>@row["Phone"]</td>
    </tr>

    <tr>
        <th>Address</th>
        <td>@row["Address"]</td>
    </tr>

</table>

<a asp-action="Index" class="btn btn-secondary">Back</a>