<!DOCTYPE html>

<html lang="en">

<head>

    ```
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FamilyDoctorMVC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>

        body {
            font-family: "Segoe UI";
            background: #eef7fb;
        }

        /* NAVBAR MEDICAL */

        .navbar-medical {
            background: linear-gradient(90deg,#26c6da,#1e88e5);
        }

        .navbar-brand {
            font-size: 22px;
            font-weight: bold;
        }

        .nav-link {
            font-weight: 500;
            margin-right: 12px;
            color: white !important;
            transition: 0.2s;
        }

            .nav-link:hover {
                transform: translateY(-1px);
                color: #e3f2fd !important;
            }

        .username {
            font-weight: 600;
            margin-right: 10px;
        }

        main {
            padding-top: 10px;
        }

    </style>
    ```

</head>

<body>

    @if (Context.Session.GetString("user") != null)
    {

        <header>

            <nav class="navbar navbar-expand-lg navbar-dark navbar-medical shadow">

                <div class="container-fluid">

                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        🏥 Family Doctor
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainMenu">

                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Index">
                                    👨‍⚕️ Doctor
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="Index">
                                    🧑 Patient
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                                    📅 Appointment
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reception" asp-action="Index">
                                    🧾 Reception
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Specialty" asp-action="Index">
                                    🩺 Specialty
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MedicalRecord" asp-action="Index">
                                    📋 Medical Record
                                </a>̉
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Prescription" asp-action="Index">
                                    💊 Prescription
                                </a>
                            </li>

                        </ul>

                        <ul class="navbar-nav">

                            <li class="nav-item">
                                <span class="nav-link username">
                                    👤 @Context.Session.GetString("user")
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-warning"
                                   asp-controller="Login"
                                   asp-action="Logout">
                                    🚪 Logout
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </nav>

        </header>

    }

    <div class="container mt-4">

        <main role="main">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
