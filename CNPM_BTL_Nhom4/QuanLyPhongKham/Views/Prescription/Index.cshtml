@using System.Data
@model DataTable

<h2>Prescription List</h2>

<a asp-action="Create" class="btn btn-success">Create</a>
<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
    🏠 Home
</a>

<br />
<br />

<table class="table table-bordered">

    <thead>
        <tr>
            <th>ID</th>
            <th>RecordId</th>
            <th>Diagnosis</th>
            <th>Note</th>
            <th>Medicine</th>
            <th>Quantity</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Rows.Count > 0)
        {
            foreach (DataRow row in Model.Rows)
            {
                <tr>

                    <td>@row["PrescriptionId"]</td>
                    <td>@row["RecordId"]</td>
                    <td>@row["Diagnosis"]</td>
                    <td>@row["Note"]</td>
                    <td>@row["MedicineName"]</td>
                    <td>@row["Quantity"]</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@row["PrescriptionId"]">Details</a> |
                        <a asp-action="Edit" asp-route-id="@row["PrescriptionId"]">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@row["PrescriptionId"]">Delete</a>
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7">No data</td>
            </tr>
        }

    </tbody>
</table>