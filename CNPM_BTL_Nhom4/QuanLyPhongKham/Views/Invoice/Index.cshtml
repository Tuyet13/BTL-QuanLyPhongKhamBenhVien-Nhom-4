@model IEnumerable<FamilyDoctorMVC.Models.Invoice>

<h2>Invoice List</h2>

<a asp-action="Create">Create Invoice</a>

<table border="1">

    <tr>
        <th>ID</th>
        <th>Appointment</th>
        <th>Total</th>
        <th>Payment Date</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.InvoiceId</td>
            <td>@item.AppointmentId</td>
            <td>@item.TotalAmount</td>
            <td>@item.PaymentDate</td>
            <td>@item.PaymentStatus</td>

            <td>

                <a asp-action="Details" asp-route-id="@item.InvoiceId">View</a>

                <a asp-action="Edit" asp-route-id="@item.InvoiceId">Edit</a>

                <a asp-action="Delete" asp-route-id="@item.InvoiceId">Delete</a>

            </td>

        </tr>
    }

</table>