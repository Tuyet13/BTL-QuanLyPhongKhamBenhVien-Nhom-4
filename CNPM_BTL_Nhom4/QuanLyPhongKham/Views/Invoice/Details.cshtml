@model FamilyDoctorMVC.Models.Invoice

<h2>Invoice Details</h2>

<table border="1">

    <tr>
        <td>ID</td>
        <td>@Model.InvoiceId</td>
    </tr>

    <tr>
        <td>Appointment</td>
        <td>@Model.AppointmentId</td>
    </tr>

    <tr>
        <td>Total Amount</td>
        <td>@Model.TotalAmount</td>
    </tr>

    <tr>
        <td>Payment Date</td>
        <td>@Model.PaymentDate</td>
    </tr>

    <tr>
        <td>Status</td>
        <td>@Model.PaymentStatus</td>
    </tr>

</table>

<a asp-action="Index">Back</a>