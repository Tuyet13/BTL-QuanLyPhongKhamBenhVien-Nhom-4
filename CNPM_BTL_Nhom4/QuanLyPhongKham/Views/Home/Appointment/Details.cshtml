@model FamilyDoctorMVC.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<h2>Appointment Details</h2>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <td>@Model.AppointmentId</td>
    </tr>

    <tr>
        <th>Patient ID</th>
        <td>@Model.PatientId</td>
    </tr>

    <tr>
        <th>Doctor</th>
        <td>@Model.DoctorUsr</td>
    </tr>

    <tr>
        <th>Date</th>
        <td>@Model.AppointmentDate</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

</table>

<a asp-action="Index" class="btn btn-secondary">Back</a>