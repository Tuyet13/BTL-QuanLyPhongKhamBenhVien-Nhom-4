@model FamilyDoctorMVC.Models.Appointment

<h2>Delete Appointment</h2>

<h4>Bạn có chắc muốn xoá?</h4>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <td>@Model.AppointmentId</td>
    </tr>

    <tr>
        <th>Patient</th>
        <td>@Model.PatientId</td>
    </tr>

    <tr>
        <th>Doctor</th>
        <td>@Model.DoctorUsr</td>
    </tr>

    <tr>
        <th>Date</th>
        <td>@Model.AppointmentDate</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

</table>

<a asp-action="Delete"
   asp-route-id="@Model.AppointmentId"
   class="btn btn-danger">
    Confirm Delete
</a>

<a asp-action="Index" class="btn btn-secondary">
    Cancel
</a>