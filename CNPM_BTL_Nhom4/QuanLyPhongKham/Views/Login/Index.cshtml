@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<style>

    body {
        margin: 0;
        font-family: Segoe UI;
        background: #e3f2fd; /* nền xanh nhạt */
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .login-box {
        width: 350px;
        background: white;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        text-align: center;
    }

        .login-box h2 {
            margin-bottom: 25px;
            color: #1976d2; /* xanh đậm */
        }

    .input-group {
        margin-bottom: 18px;
        text-align: left;
    }

        .input-group label {
            font-weight: 600;
            color: #555;
        }

        .input-group input {
            width: 100%;
            padding: 10px;
            margin-top: 6px;
            border-radius: 8px;
            border: 1px solid #90caf9; /* viền xanh nhạt */
            font-size: 14px;
        }

            .input-group input:focus {
                outline: none;
                border-color: #1976d2;
                box-shadow: 0 0 5px rgba(25,118,210,0.3);
            }

    .password-box {
        position: relative;
    }

    .toggle {
        position: absolute;
        right: 10px;
        top: 36px;
        cursor: pointer;
        font-size: 18px;
    }

    button {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 8px;
        background: #1976d2; /* xanh chính */
        color: white;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
    }

        button:hover {
            background: #1565c0; /* xanh đậm hơn khi hover */
        }

    .error {
        color: red;
        margin-top: 10px;
    }

</style>

<div class="login-box">

    ```
    <h2>Family Doctor Login</h2>

    <form method="post">

        <div class="input-group">
            <label>Tài khoản</label>
            <input type="text" name="username" required />
        </div>

        <div class="input-group password-box">
            <label>Mật khẩu</label>
            <input type="password" name="password" id="password" required />
            <span class="toggle" onclick="togglePassword()">🙈</span>
        </div>

        <button type="submit">Đăng nhập</button>

    </form>

    @if (ViewBag.Error != null)
    {
        <div class="error">@ViewBag.Error</div>
    }
    ```

</div>

<script>

    function togglePassword(){

        var pass = document.getElementById("password");
        var icon = document.querySelector(".toggle");

        if(pass.type === "password"){
            pass.type = "text";
            icon.innerHTML = "🙉";
        }
        else{
            pass.type = "password";
            icon.innerHTML = "🙈";
        }

    }

</script>
