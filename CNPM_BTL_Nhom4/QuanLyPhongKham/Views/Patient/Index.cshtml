
<style>
    .patient-page {
        padding: 20px;
    }

    .btn-add {
        display: inline-block;
        margin-bottom: 10px;
        padding: 8px 12px;
        background-color: #4CAF50;
        color: white;
        text-decoration: none;
        border-radius: 4px;
    }

    .btn-home {
        display: inline-block;
        margin-left: 10px;
        padding: 8px 12px;
        background-color: #2196F3;
        color: white;
        text-decoration: none;
        border-radius: 4px;
    }

    .patient-table {
        width: 100%;
        border-collapse: collapse;
    }

    .patient-table th, .patient-table td {
        border: 1px solid #ddd;
        padding: 8px;
    }

    .patient-table th {
        background-color: #f2f2f2;
    }

    .action a {
        margin-right: 5px;
        padding: 5px 10px;
        text-decoration: none;
        border-radius: 4px;
    }

    .btn-details {
        background-color: #2196F3;
        color: white;
    }

    .btn-edit {
        background-colobr: #FFC107;
        color: white;
    }

    .btn-delete {
        background-color: #F44336;
        color: white;
    }
</style>

<div class="patient-page">

    <h2>Danh sách bệnh nhân</h2>

    <a asp-action="Create" class="btn-add">
        Thêm bệnh nhân
    </a>

    <a asp-controller="Home" asp-action="Index" class="btn-home">
        Back Home
    </a>

    <table class="patient-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Tên</th>
                <th>Giới tính</th>
                <th>Ngày sinh</th>
                <th>Điện thoại</th>
                <th>Địa chỉ</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var p in Model)
            {
                <tr>

                    <td>@p.PatientId</td>
                    <td>@p.PatientName</td>
                    <td>@(p.Gender ? "Nam" : "Nữ")</td>
                    <td>@p.Dob.ToString("dd/MM/yyyy")</td>
                    <td>@p.Phone</td>
                    <td>@p.Address</td>

                    <td class="action">

                        <a asp-action="Details" asp-route-id="@p.PatientId" class="btn-details">
                            Details
                        </a>

                        <a asp-action="Edit" asp-route-id="@p.PatientId" class="btn-edit">
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@p.PatientId" class="btn-delete">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>
    </table>

</div>