@model FamilyDoctorMVC.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<h2>Chi tiết bệnh nhân</h2>

<p><b>ID:</b> @Model.PatientId</p>
<p><b>Tên:</b> @Model.PatientName</p>
<p><b>Giới tính:</b> @(Model.Gender ? "Nam" : "Nữ")</p>
<p><b>Ngày sinh:</b> @Model.Dob.ToString("dd/MM/yyyy")</p>
<p><b>Phone:</b> @Model.Phone</p>
<p><b>Address:</b> @Model.Address</p>
<p><b>Username:</b> @Model.Username</p>

<a asp-action="Index" class="btn btn-secondary">Back</a>